# Copy this file to .env.local and fill in all values before running the app.
# Never commit .env.local to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (used by Drizzle ORM + postgres-js)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Found in: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# ─── Supabase (server-side secrets — never expose to the browser) ─────────────
# Found in: Supabase Dashboard → Settings → API
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── Supabase (client-side — safe to expose, must have NEXT_PUBLIC_ prefix) ──
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Account ID: Cloudflare Dashboard → R2 → top-right corner
R2_ACCOUNT_ID="xxxx"
# R2 API Token credentials (create at: Cloudflare Dashboard → R2 → Manage R2 API tokens)
R2_ACCESS_KEY_ID="xxxx"
R2_SECRET_ACCESS_KEY="xxxx"
# The R2 bucket name (create at: Cloudflare Dashboard → R2 → Create bucket)
R2_BUCKET_NAME="my-bucket"
# Public base URL for the bucket (enable public access in R2 settings or use a custom domain)
# Examples: https://pub-xxxx.r2.dev  OR  https://assets.yourdomain.com
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
